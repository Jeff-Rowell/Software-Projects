    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <script>
        $(document).ready(function () {
            $('#bs-example-navbar-collapse-1.nav a[href="' + this.location.pathname + '"]').parent().addClass('active');
        });
    </script>



</head>
<body id=" layoutcw2" data-spy="scroll" data-target=".cw-mainNav">
    <div class="container-fluid">
        <div class="row-fluid">
            <div class="col-md-3">
                <p class="site-title ">CW Master Teacher</p>
            </div>

            <div class="col-md-6">
                <div class="row-fluid">
                    <nav class="nav navbar-default float-left" id=" mainNav">
                        <div class="container-fluid">
                            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                                <ul class="nav navbar-nav " id=" mainNav">
                                    <li><a href="@Url.Action("Index", "Curriculum")">Curriculum</a></li>
                                    <li><a href="@Url.Action("Index","DailyPlanning")">Daily Planning</a></li>
                                    <li><a href="@Url.Action("Index","Classroom")">Classroom</a></li>
                                    @*<li><a href="@Url.Action("Index","ToDoList")">ToDoList</a></li>*@
                                    @if (Model.UserIsApplicationAdmin || Model.UserIsWorkingGroupAdmin)
                                    {
                                        <li class="dropdown">
                                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">Admin <span class="caret"></span></a>
                                            <ul class="dropdown-menu" role="menu">
                                                <li><a href="@Url.Action("Index", "UserAdmin")">Create or Edit User</a></li>
                                                <li><a href="@Url.Action("Index", "AdminResetPassword")">Admin Reset Password</a></li>
                                                <li class="divider"></li>
                                                <li><a href="@Url.Action("Index", "CourseCopyAdmin", new { successMessage = "", isMaster = true })">Copy New Master Course from Existing Course</a></li>
                                                <li><a href="@Url.Action("Index", "CourseCopyAdmin", new { successMessage = "", isMaster = false })">Copy New Individual Course from Existing Course</a></li>
                                                <li><a href="@Url.Action("Index", "CourseCreateAdmin", new { successMessage = "", isMaster = false })">Create Master Course</a></li>
                                                <li><a href="@Url.Action("Index", "CourseCreateAdmin", new { successMessage = "", isMaster = false })">Edit or Delete Course</a></li>
                                                <li class="divider"></li>
                                                <li><a href=@Url.Action("Index", "WorkingGroupAdmin", routeValues: new { })>Create or Edit Working Group</a></li>
                                                <li><a href="@Url.Action("Index", "TermAdmin")">Create or Edit Term</a></li>
                                                <li><a href="@Url.Action("Index", "ClassSectionAdmin")">Create Class Section</a></li>
                                                <li><a href="@Url.Action("Index", "ClassMeetingAdmin")">Edit Class Meetings or Class Section</a></li>
                                                @*<li><a href="@Url.Action("Index", "LevelSet")">Edit Level Set</a></li>*@
                                                <li class="divider"></li>
                                                <li><a href="@Url.Action("Index", "ZDevelopment")">Show Development View</a></li>

                                            </ul>
                                        </li>
                                    }


                                </ul>
                            </div>

                        </div>
                    </nav>


                </div>
            </div> <!--End col-md-6-->
            <div class="col-md-3">
                <div class="row">

                    <div class="float-right">
                        <section id="login">
                            @Html.Partial("_LoginPartial")
                        </section>
                    </div>
                    <div class="btn-group float-right cw-space-right-bigskip">
                        <a class="dropdown-toggle cw-gear" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="@Url.Action("Index", "WorkingRelationship")">Edit Narrative Sources</a>
                            </li>
                        </ul>
                    </div><!--End Button Group-->
                </div>
            </div>
            <div id="body">
                <section class="main-content clear-fix">
                    @RenderBody()
                </section>
            </div>

        </div>


    </div>
</body>
</html>
